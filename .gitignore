# Build output. Regenerate with `npm run build` / `npm run build:artifacts`
dist/
artifacts/

# Vercel
.vercel/

# Node
node_modules/
npm-debug.log*
*.log

# Private working material: screenshots, Search Console exports, other projects.
# Deliberately excluded, this repo is pushed to GitHub.
Proof/

# Local working folders. Large, and not part of the site.
# Anything Studio publishes must be copied into docs/ or src/ instead,
# so the Vercel build never depends on a folder that is not in the repo.
medpark-live/
medpark-site-audit/
medpark-dashboard/
247clinic-src/
247clinic-plan/
pack/
video/
brand guideline/
*.jpg
!src/assets/*.jpg
!docs/**/*.jpg

# OS
.DS_Store
Thumbs.db
desktop.ini

# API keys. This repo is public, so nothing with a key in it is ever committed.
.env
.env.local
secrets/

# Pristine download of the 247clinic.net site. src/247site is generated from it.
.work/

# Playwright MCP test logs and page snapshots. Local only.
.playwright-mcp/

# HCIG Hive runtime state. Holds agent logs, the shared brain (copied from private
# memory) and account profiles, so it never goes into this public repo.
.hive/
# Generated by the Hive from .hive/tasks.json. Agent notes in it can name servers.
TASK_BOARD.md

# Python bytecode from the build scripts.
__pycache__/
*.pyc

# Licensed fonts supplied by the user. Never commit the raw files (repo is public).
247 material/*.ttf
247 material/*.otf

# TMASI working material: news drafts and photos from Mohamed (kept local).
tmasi material/
tmasi sponsor/

# TMASI live-site mirror and backups (may hold server secrets; repo is public).
tmasi-live/
