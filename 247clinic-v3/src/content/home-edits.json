{
  "rules": [
    {
      "media": "desktop",
      "selector": "#hero-h > span.ln:nth-of-type(1)",
      "props": {
        "zoom": "0.9"
      }
    },
    {
      "media": "desktop",
      "selector": "#hero-h > span.ln:nth-of-type(2)",
      "props": {
        "zoom": "0.8"
      }
    },
    {
      "media": "desktop",
      "selector": "[data-e-section=\"Facilities\"] > section.section > div.container",
      "props": {
        "zoom": "0.8"
      }
    },
    {
      "media": "desktop",
      "selector": "[data-e-section=\"Facilities\"] > section.section > div.container > div.head > span.eyebrow",
      "props": {
        "zoom": "2.0"
      }
    },
    {
      "media": "desktop",
      "selector": "[data-e-section=\"Facilities\"] > section.section > div.container > div.head > div.lead > p",
      "props": {
        "zoom": "1.1"
      }
    },
    {
      "media": "desktop",
      "selector": "[data-e-section=\"Services\"] > section.section > div.container > div.head-row > div.head > span.eyebrow",
      "props": {
        "zoom": "1.3"
      }
    },
    {
      "media": "desktop",
      "selector": "[data-e-section=\"Intro\"] > section.section > div.container > div.intro-copy > div.head > span.eyebrow",
      "props": {
        "zoom": "1.3"
      }
    },
    {
      "media": "desktop",
      "selector": "[data-e-section=\"HowItWorks\"] > section.section > div.container > div.head > span.eyebrow",
      "props": {
        "zoom": "1.4"
      }
    },
    {
      "media": "desktop",
      "selector": "[data-e-section=\"Insurance\"] > section.section > div.container > div.stack > div.head > span.eyebrow",
      "props": {
        "zoom": "1.4"
      }
    },
    {
      "media": "desktop",
      "selector": "[data-e-section=\"Insurance\"] > section.section > div.band > span.band-label",
      "props": {
        "zoom": "1.4"
      }
    },
    {
      "media": "desktop",
      "selector": "[data-e-section=\"Stories\"] > section.section > div.container > div.head > span.eyebrow",
      "props": {
        "zoom": "1.4"
      }
    },
    {
      "media": "desktop",
      "selector": "#clinics > div.container > div.head > span.eyebrow",
      "props": {
        "zoom": "1.3"
      }
    },
    {
      "media": "desktop",
      "selector": "#clinics > div.container > div.finder-grid > div.finder-side > div.chips",
      "props": {
        "text-align": "left"
      }
    },
    {
      "media": "desktop",
      "selector": "[data-e-section=\"HotelBand\"] > section.proof",
      "props": {
        "zoom": "0.8"
      }
    },
    {
      "media": "desktop",
      "selector": "[data-e-section=\"HotelBand\"] > section.proof > div.container > ul.stats",
      "props": {
        "zoom": "1.1"
      }
    },
    {
      "media": "desktop",
      "selector": "body > header.site-header > div.hdr",
      "props": {
        "zoom": "1.1"
      }
    },
    {
      "media": "desktop",
      "selector": "body > header.site-header > div.hdr > div.hdr-actions > a.btn:nth-of-type(2)",
      "props": {
        "zoom": "0.7"
      }
    },
    {
      "media": "desktop",
      "selector": "body > header.site-header > div.hdr > div.hdr-actions > a.btn:nth-of-type(1)",
      "props": {
        "zoom": "0.7"
      }
    },
    {
      "media": "desktop",
      "selector": "body > footer.site-footer > div.container > div.help-band",
      "props": {
        "zoom": "0.8"
      }
    },
    {
      "media": "desktop",
      "selector": "[data-e-section=\"Posts\"] > section.section > div.container",
      "props": {
        "zoom": "0.8"
      }
    }
  ]
}
