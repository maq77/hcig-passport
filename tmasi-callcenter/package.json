{
  "name": "tmasi-callcenter",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tc/web",
    "build": "npm run build -w @tc/web",
    "start": "npm run start -w @tc/web",
    "test": "node scripts/check-copy.mjs && vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p apps/web --noEmit",
    "migrate": "tsx scripts/migrate.mjs",
    "seed:admin": "tsx scripts/seed-admin.mjs",
    "kb:build": "tsx scripts/kb-build.mjs",
    "kb:sync": "tsx scripts/kb-sync.mjs",
    "agent:push": "tsx scripts/agent-push.mjs",
    "eval": "tsx scripts/eval-run.mjs",
    "import:call": "tsx scripts/import-call.mjs",
    "key:use": "tsx scripts/key-use.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.9.0",
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-pgvector": "0.0.17",
    "@elevenlabs/client": "1.36.1",
    "@elevenlabs/elevenlabs-js": "2.79.0",
    "@elevenlabs/react": "1.22.1",
    "@huggingface/transformers": "4.3.2",
    "argon2": "0.45.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
