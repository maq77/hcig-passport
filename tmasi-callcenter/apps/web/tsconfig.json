{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@tc/core": ["../../packages/core/src/index.ts"],
      "@tc/db": ["../../packages/db/src/index.ts"],
      "@tc/voice": ["../../packages/voice/src/index.ts"],
      "@tc/llm": ["../../packages/llm/src/index.ts"],
      "@tc/kb": ["../../packages/kb/src/index.ts"],
      "@tc/evals": ["../../packages/evals/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
